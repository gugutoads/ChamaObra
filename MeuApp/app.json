{
  "expo": {
    "name": "ChamaObra",
    "slug": "MeuApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "meuapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBXM2p_5mqq3vvFkbkGHQd7jMm1W97JOJY"
        }
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Precisamos da sua localização para mostrar serviços próximos e permitir a seleção do endereço do serviço.",
        "NSCameraUsageDescription": "Precisamos acesso à câmera para tirar fotos do local do serviço.",
        "NSPhotoLibraryUsageDescription": "Precisamos acesso à galeria para selecionar fotos do local do serviço."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/background.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBXM2p_5mqq3vvFkbkGHQd7jMm1W97JOJY"
        }
      },
      "package": "com.anonymous.MeuApp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Precisamos da sua localização para permitir a seleção do endereço do serviço no mapa."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Precisamos acesso à galeria para selecionar fotos do local do serviço.",
          "cameraPermission": "Precisamos acesso à câmera para tirar fotos do local do serviço."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
